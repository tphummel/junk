{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "./worker-configuration.d.ts"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "api/**/*.ts",
    "jigseer-saas/src/**/*.ts",
    "web/golden-angle-palette/palette.js",
    "worker-configuration.d.ts"
  ]
}
