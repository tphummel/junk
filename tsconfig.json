{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "./worker-configuration.d.ts"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "api/**/*.ts",
    "web/controller-lab/app.js",
    "web/controller-lab/deviceinfo.js",
    "web/controller-lab/names.js",
    "web/controller-lab/registry.js",
    "web/controller-lab/transcript.js",
    "web/golden-angle-palette/palette.js",
    "web/tetris/src/game/*.js",
    "web/tetris/src/input/*.js",
    "web/tetris/src/ui/*.js",
    "web/tetris/src/main.js",
    "worker-configuration.d.ts"
  ]
}
