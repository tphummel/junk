{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "junk",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./web",
    // Only /api/* runs Worker code; everything else is served as static files from web/.
    "run_worker_first": ["/api/*"]
  },
  // No workers.dev URL; the Worker is only reachable on the custom domain.
  "workers_dev": false,
  // Keep Version URLs / Preview URLs for PR and branch builds.
  "preview_urls": true,
  "routes": [
    { "pattern": "junk.tomhummel.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
  // Bindings (KV, D1, R2, Durable Objects) get added here as APIs need them.
}
