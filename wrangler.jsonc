{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "junk",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./web",
    // Only /api/* and /jigseer/* (except /jigseer/static/*) run Worker code; everything else is
    // served as static files from web/.
    "run_worker_first": ["/api/*", "/jigseer/*", "!/jigseer/static/*"]
  },
  // No workers.dev URL; the Worker is only reachable on the custom domain.
  "workers_dev": false,
  // Keep Version URLs / Preview URLs for PR and branch builds.
  "preview_urls": true,
  "routes": [
    // previews_enabled: PR/branch Previews are served at <branch>.junk.tomhummel.com
    // (Cloudflare manages a wildcard DNS record + certificate for *.junk.tomhummel.com).
    { "pattern": "junk.tomhummel.com", "custom_domain": true, "previews_enabled": true }
  ],
  "observability": { "enabled": true },
  // Required by `wrangler preview` (used for PR/branch preview builds). Previews do NOT
  // inherit production settings: when adding vars or KV/D1/R2 bindings above, add matching
  // entries here that point at test resources. See
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    "d1_databases": [{ "binding": "JIGSEER_DB", "database_name": "jigseer-preview" }]
  },
  // Bindings, prefixed by project (ADR 0007). Create the database by hand first:
  //   npx wrangler d1 create jigseer && npx wrangler d1 create jigseer-preview
  // then add each "database_id" it prints. migrations_dir is applied by the deploy command.
  "d1_databases": [
    {
      "binding": "JIGSEER_DB",
      "database_name": "jigseer",
      "migrations_dir": "jigseer-hosted/migrations"
    }
  ]
}
